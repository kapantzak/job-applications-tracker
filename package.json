{
  "name": "job-applications-tracker",
  "version": "0.1.0",
  "description": "Local job applications tracker that uses your own agent CLI to find openings and sync application status from Gmail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kapantzak/job-applications-tracker.git"
  },
  "homepage": "https://github.com/kapantzak/job-applications-tracker#readme",
  "bugs": {
    "url": "https://github.com/kapantzak/job-applications-tracker/issues"
  },
  "keywords": [
    "job-search",
    "job-applications",
    "tracker",
    "gmail",
    "claude-code",
    "codex",
    "local-first"
  ],
  "type": "module",
  "bin": {
    "jobtrack": "bin/jobtrack.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "dist",
    "prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && vite build",
    "dev:server": "tsx watch src/server/index.ts",
    "sandbox": "npm run build && node bin/jobtrack.js --data-dir .tmp/sandbox",
    "sandbox:mock": "npm run build && tsx scripts/sandbox-mock/prepare.ts && node bin/jobtrack.js --data-dir .tmp/sandbox-mock",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "dev:ui": "vite",
    "typecheck:ui": "tsc -p tsconfig.ui.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.16",
    "mammoth": "^1.13.0",
    "open": "^11.0.4",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.70.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
